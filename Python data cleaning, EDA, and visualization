        "print(\"Shape:\", master_df.shape)\n",
        "print(\"\\nKolom:\")\n",
        "print(master_df.columns.tolist())\n",
        "\n",
        "print(\"\\n5 data pertama:\")\n",
        "display(master_df.head())"
      ],
