    {
      "cell_type": "code",
      "source": [
        "#Set master_query as master table (joining 5 tables)\n",
        "master_query = \"\"\"\n",
        "WITH subscription_summary AS (\n",
        "    SELECT\n",
        "        account_id,\n",
        "        COUNT(DISTINCT subscription_id) AS total_subscriptions,\n",
        "        SUM(mrr_amount) AS total_mrr,\n",
        "        SUM(arr_amount) AS total_arr,\n",
        "        AVG(mrr_amount) AS avg_mrr,\n",
        "        MAX(mrr_amount) AS max_mrr,\n",
        "        SUM(CASE WHEN upgrade_flag THEN 1 ELSE 0 END) AS total_upgrades,\n",
        "        SUM(CASE WHEN downgrade_flag THEN 1 ELSE 0 END) AS total_downgrades,\n",
        "        SUM(CASE WHEN churn_flag THEN 1 ELSE 0 END) AS subscription_churn_events\n",
        "    FROM subscriptions\n",
        "    GROUP BY account_id\n",
        "),\n",
        "\n",
        "usage_summary AS (\n",
        "    SELECT\n",
        "        s.account_id,\n",
        "        COUNT(DISTINCT f.usage_id) AS total_usage_records,\n",
        "        SUM(f.usage_count) AS total_usage_count,\n",
        "        SUM(f.usage_duration_secs) AS total_usage_duration_secs,\n",
        "        SUM(f.error_count) AS total_errors,\n",
        "        COUNT(DISTINCT f.feature_name) AS unique_features_used,\n",
        "        SUM(\n",
        "            CASE\n",
        "                WHEN f.is_beta_feature THEN 1\n",
        "                ELSE 0\n",
        "            END\n",
        "        ) AS beta_usage_records\n",
        "    FROM feature_usage f\n",
        "    JOIN subscriptions s\n",
        "        ON f.subscription_id = s.subscription_id\n",
        "    GROUP BY s.account_id\n",
        "),\n",
        "\n",
        "support_summary AS (\n",
        "    SELECT\n",
        "        account_id,\n",
        "        COUNT(DISTINCT ticket_id) AS total_tickets,\n",
        "        AVG(resolution_time_hours) AS avg_resolution_time_hours,\n",
        "        AVG(first_response_time_minutes) AS avg_first_response_minutes,\n",
        "        AVG(satisfaction_score) AS avg_satisfaction_score,\n",
        "        SUM(\n",
        "            CASE\n",
        "                WHEN escalation_flag THEN 1\n",
        "                ELSE 0\n",
        "            END\n",
        "        ) AS total_escalations\n",
        "    FROM support_tickets\n",
        "    GROUP BY account_id\n",
        "),\n",
        "\n",
        "churn_summary AS (\n",
        "    SELECT\n",
        "        account_id,\n",
        "        COUNT(DISTINCT churn_event_id) AS total_churn_events,\n",
        "        MIN(churn_date) AS first_churn_date,\n",
        "        MAX(churn_date) AS latest_churn_date,\n",
        "        SUM(refund_amount_usd) AS total_refund_amount,\n",
        "        SUM(\n",
        "            CASE\n",
        "                WHEN preceding_upgrade_flag THEN 1\n",
        "                ELSE 0\n",
        "            END\n",
        "        ) AS preceding_upgrade_events,\n",
        "        SUM(\n",
        "            CASE\n",
        "                WHEN preceding_downgrade_flag THEN 1\n",
        "                ELSE 0\n",
        "            END\n",
        "        ) AS preceding_downgrade_events,\n",
        "        SUM(\n",
        "            CASE\n",
        "                WHEN is_reactivation THEN 1\n",
        "                ELSE 0\n",
        "            END\n",
        "        ) AS reactivation_events\n",
        "    FROM churn_events\n",
        "    GROUP BY account_id\n",
        ")\n",
        "\n",
        "SELECT\n",
        "    a.account_id,\n",
        "    a.account_name,\n",
        "    a.industry,\n",
        "    a.country,\n",
        "    a.signup_date,\n",
        "    a.referral_source,\n",
        "    a.plan_tier,\n",
        "    a.seats,\n",
        "    a.is_trial,\n",
        "    a.churn_flag,\n",
        "\n",
        "    COALESCE(ss.total_subscriptions, 0) AS total_subscriptions,\n",
        "    COALESCE(ss.total_mrr, 0) AS total_mrr,\n",
        "    COALESCE(ss.total_arr, 0) AS total_arr,\n",
        "    COALESCE(ss.avg_mrr, 0) AS avg_mrr,\n",
        "    COALESCE(ss.max_mrr, 0) AS max_mrr,\n",
        "    COALESCE(ss.total_upgrades, 0) AS total_upgrades,\n",
        "    COALESCE(ss.total_downgrades, 0) AS total_downgrades,\n",
        "    COALESCE(ss.subscription_churn_events, 0) AS subscription_churn_events,\n",
        "\n",
        "    COALESCE(us.total_usage_records, 0) AS total_usage_records,\n",
        "    COALESCE(us.total_usage_count, 0) AS total_usage_count,\n",
        "    COALESCE(us.total_usage_duration_secs, 0) AS total_usage_duration_secs,\n",
        "    COALESCE(us.total_errors, 0) AS total_errors,\n",
        "    COALESCE(us.unique_features_used, 0) AS unique_features_used,\n",
        "    COALESCE(us.beta_usage_records, 0) AS beta_usage_records,\n",
        "\n",
        "    COALESCE(sp.total_tickets, 0) AS total_tickets,\n",
        "    COALESCE(sp.avg_resolution_time_hours, 0) AS avg_resolution_time_hours,\n",
        "    COALESCE(sp.avg_first_response_minutes, 0) AS avg_first_response_minutes,\n",
        "    COALESCE(sp.avg_satisfaction_score, 0) AS avg_satisfaction_score,\n",
        "    COALESCE(sp.total_escalations, 0) AS total_escalations,\n",
        "\n",
        "    COALESCE(cs.total_churn_events, 0) AS total_churn_events,\n",
        "    cs.first_churn_date,\n",
        "    cs.latest_churn_date,\n",
        "    COALESCE(cs.total_refund_amount, 0) AS total_refund_amount,\n",
        "    COALESCE(cs.preceding_upgrade_events, 0) AS preceding_upgrade_events,\n",
        "    COALESCE(cs.preceding_downgrade_events, 0) AS preceding_downgrade_events,\n",
        "    COALESCE(cs.reactivation_events, 0) AS reactivation_events\n",
        "\n",
        "FROM accounts a\n",
        "\n",
        "LEFT JOIN subscription_summary ss\n",
        "    ON a.account_id = ss.account_id\n",
        "\n",
        "LEFT JOIN usage_summary us\n",
        "    ON a.account_id = us.account_id\n",
        "\n",
        "LEFT JOIN support_summary sp\n",
        "    ON a.account_id = sp.account_id\n",
        "\n",
        "LEFT JOIN churn_summary cs\n",
        "    ON a.account_id = cs.account_id\n",
        "\n",
        "ORDER BY a.account_id;\n",
        "\"\"\"\n",
        "#set as dataframe\n",
        "master_df = pd.read_sql(master_query, engine)\n",
